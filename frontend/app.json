{
  "expo": {
    "name": "Cloumy",
    "slug": "cloumy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.cloumy",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["comgooglemaps", "nmap"],
        "NSLocalNetworkUsageDescription": "개발 중 로컬 네트워크의 Metro 번들러 및 백엔드 서버에 연결하기 위해 사용됩니다.",
        "NSBonjourServices": ["_expo._tcp"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "cloumy",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "react-native-maps",
        {
          "googleMapsApiKey": ""
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cloumy가 실제 위치 기준으로 정확한 길찾기를 제공하기 위해 위치 정보를 사용합니다."
        }
      ]
    ]
  }
}
