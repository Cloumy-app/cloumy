# ─────────────────────────────────────────────────────
# FastAPI AI 서비스 전용 환경 변수 (예시)
# Spring Boot 환경 변수는 루트 .env.example 참고
# ─────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────
# Database (PostgreSQL — asyncpg 포맷)
# ─────────────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://cloumy:your_password@localhost:5432/cloumy

# ─────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────────────
# AI 모델 API
# ─────────────────────────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# https://platform.openai.com → API Keys (임베딩용 — text-embedding-3-small)
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────
# 외부 API
# ─────────────────────────────────────────────────────
# 카카오 로컬 API (RAG 후보 보충, 장소 검색) — 루트 .env 의 KAKAO_CLIENT_ID 와 동일한 값
KAKAO_REST_API_KEY=
# Google Distance Matrix API (OR-Tools TSP 이동 거리 계산)
GOOGLE_MAPS_API_KEY=
# https://openweathermap.org → My API Keys (무료 티어: 일 1,000콜)
OPENWEATHERMAP_API_KEY=
# https://www.data.go.kr → 한국관광공사 TourAPI (무료)
TOURAPI_KEY=
# 네이버 블로그 검색 API — 트렌딩 장소 수집 파이프라인 (Phase 1 후반)
# https://developers.naver.com → 검색 API 사용 신청
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# ─────────────────────────────────────────────────────
# 내부 통신 (Spring ↔ FastAPI)
# ─────────────────────────────────────────────────────
# 루트 .env 의 INTERNAL_API_KEY 와 동일한 값
INTERNAL_API_KEY=
