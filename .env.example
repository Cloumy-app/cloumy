# ─────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────
POSTGRES_USER=cloumy
POSTGRES_PASSWORD=your_db_password
# Spring Boot 용 JDBC URL (application.yml → ${POSTGRES_JDBC_URL})
# FastAPI 용 asyncpg URL 은 ai/.env.example 의 POSTGRES_URL 참고
POSTGRES_JDBC_URL=jdbc:postgresql://localhost:5432/cloumy

# ─────────────────────────────────────────────────────
# Redis (Spring Boot)
# ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────
JWT_SECRET=                  # 최소 32자 랜덤 문자열 (openssl rand -hex 32)
JWT_ACCESS_TTL=3600          # 액세스 토큰 유효 시간 (초)
JWT_REFRESH_TTL=1209600      # 리프레시 토큰 유효 시간 (초, 기본 14일)

# ─────────────────────────────────────────────────────
# 소셜 로그인 OAuth (Spring Boot)
# ─────────────────────────────────────────────────────
# 카카오: https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/auth/callback/kakao

# 구글: https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback/google

# 네이버: https://developers.naver.com → 애플리케이션 → 로그인 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8080/auth/callback/naver

# ─────────────────────────────────────────────────────
# 외부 API (Spring Boot)
# ─────────────────────────────────────────────────────
# KAKAO_CLIENT_ID 와 동일한 키 — Kakao Local API(장소 검색)에도 사용
KAKAO_REST_API_KEY=
# Google Cloud Console → Maps SDK, Distance Matrix, Geocoding API 활성화 필요
GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────────────
# 결제
# ─────────────────────────────────────────────────────
# 토스페이먼츠: https://developers.tosspayments.com → 테스트 시크릿 키
TOSS_PAYMENTS_SECRET_KEY=

# ─────────────────────────────────────────────────────
# 내부 통신 (Spring ↔ FastAPI)
# ─────────────────────────────────────────────────────
# openssl rand -hex 32 로 생성 후 GitHub Secrets 에도 등록
INTERNAL_API_KEY=

# ─────────────────────────────────────────────────────
# CI/CD (운영 배포 시 사용)
# ─────────────────────────────────────────────────────
IMAGE_TAG=latest
